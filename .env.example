# Copy to .env (git-ignored). Values below are local-development defaults.

# Browser-exposed base URL of the analysis API (baked into the web bundle at build time).
# Never place credentials in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8000

# API service (Phase 3+)
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
MAX_CSV_MB=25
MAX_BOOTSTRAP_REPS=10000
DATA_RETENTION_HOURS=24
# Directory for the SQLite job store and per-job folders; a mounted volume on Railway.
DATA_DIR=./.sem-studio-data
