{
  "name": "@sem-studio/web",
  "version": "0.0.0",
  "private": true,
  "description": "SEM Studio web application (React 19 + TypeScript + Vite SPA).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write . --ignore-path ../../.prettierignore --ignore-path ../../.gitignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore --ignore-path ../../.gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "spike:evidence": "SEM_WRITE_EVIDENCE=1 vitest run src/tests/spike && node scripts/collect-licenses.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@sem-studio/contracts": "1.0.0",
    "@sem-studio/method-registry": "1.0.0",
    "@tanstack/react-query": "5.107.1",
    "@xyflow/react": "12.12.1",
    "d3-array": "3.2.5",
    "d3-scale": "4.0.3",
    "dexie": "4.4.7",
    "elkjs": "0.12.1",
    "lucide-react": "1.72.0",
    "papaparse": "5.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/d3-array": "3.2.2",
    "@types/d3-scale": "4.0.9",
    "@types/node": "26.6.6",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
