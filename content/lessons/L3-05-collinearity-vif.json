  "checks": [
    {
      "id": "vif-calc",
      "question": "Regressing predictor j on the other predictors gives R² = .80. What is its VIF?",
      "multiple": false,
      "options": [
        {
          "id": "a",
          "text": "5",
          "correct": true,
          "feedback": "Correct: 1 / (1 − .80) = 5."
        },
        {
          "id": "b",
          "text": "1.25",
          "correct": false,
          "feedback": "That is 1 / .80; the denominator is 1 − R²."
        },
        {
          "id": "c",
          "text": ".20",
          "correct": false,
          "feedback": ".20 is the tolerance (1 − R²); VIF is its reciprocal."
        }
      ],
      "explanation": "VIF = 1 / tolerance."
    },
    {
      "id": "where-vif",
      "question": "Where is the VIF a relevant criterion? Select all that apply.",
      "multiple": true,
      "options": [
        {
          "id": "a",
          "text": "Predictor constructs of the same endogenous construct",
          "correct": true,
          "feedback": "Correct. Structural paths are regression coefficients."
        },
        {
          "id": "b",
          "text": "Indicators of a Mode B (formative) block",
          "correct": true,
          "feedback": "Correct. Mode B weights are regression coefficients too."
        },
        {
          "id": "c",
          "text": "Indicators of a reflective block",
          "correct": false,
          "feedback": "Reflective indicators are supposed to correlate; their VIF is not a quality criterion."
        }
      ],
      "explanation": "VIF matters wherever regression weights are estimated."
    }
  ],
  "references": [
    "hair2022",
    "hair2019"
  ],
  "glossary": [
