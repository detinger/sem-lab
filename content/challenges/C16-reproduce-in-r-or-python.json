      "tolerance": 0.0005,
      "feedbackCorrect": "Correct. The exported script reproduces the app's estimate.",
      "feedbackWrong": "Not the expected value. Check that the script read the exported data file unchanged and that you copied the direct path PEOU → BI.",
      "derivation": {
        "source": {
          "fixture": "tam-mediation"
        },
        "analysis": {
          "method": "pls-sem",
          "engine": "browser",
          "estimator": "pls-pm",
          "missingData": "listwise",
          "pls": {
            "innerWeighting": "path",
            "maxIterations": 300,
            "tolerance": 1e-07
          }
        },
        "parameterKey": "path:c_peou->c_bi"
      }
    },
    {
      "id": "ran",
      "dimension": "reporting",
      "kind": "self-assess",
      "prompt": "Tick what you did.",
      "checklist": [
        "I exported the script together with its data file and README",
        "I installed the required packages at the versions the README names (or noted the versions I used)",
        "I ran the script without editing the data file",
        "The Python script's final check reported OK (or the R output matched the app's paths)",
        "I recorded the software versions for my methods section"
      ]
    },
    {
      "id": "mismatch",
      "dimension": "interpretation",
      "kind": "choice",
      "prompt": "A classmate's script prints PEOU → BI = .0994. What is the most likely reason?",
      "multiple": false,
      "options": [
        {
          "id": "a",
          "text": "They exported a PLSc run, which targets a different estimand.",
          "correct": true,
          "feedback": "Correct. PLSc gives about .099 for this path; the export reproduces whatever method was run."
        },
        {
          "id": "b",
          "text": "Floating-point differences between R and the browser.",
          "correct": false,
          "feedback": "Those are around 1e-12, far below a difference of .03."
        },
        {
          "id": "c",
          "text": "Random variation of the PLS algorithm.",
          "correct": false,
          "feedback": "The PLS point estimates are deterministic; no seed is involved without bootstrapping."
        }
      ]
    }
  ],
  "hints": [
    "The export button is on the Results page of a finished run.",
    "Follow the README in the exported folder; it names the packages and how to start the script.",
    "The Python script prints a structural-paths table and a final agreement check; the R script prints cSEM's summary."
  ],
  "solution": [
    {
      "kind": "p",
      "text": "The exported script estimates the same model on the same prepared data and reproduces PEOU → BI = .1276 (the browser engine and the exports agree to about 1e-12 for PLS). A large difference means different inputs: another method (PLSc gives ≈ .0994), edited data or changed options."
    }
  ]
