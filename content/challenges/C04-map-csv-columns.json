  ],
  "solution": [
    {
      "kind": "p",
      "text": "Indicator pu4 was bound to \"pu5\" and bi3 to \"bi_4\"; neither column exists. Binding them to pu4 and bi3 lets the model run. With the correct mapping AVE(BI) ≈ .806."
    }
  ],
