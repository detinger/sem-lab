      "prompt": "Bind every indicator to the data column that holds its responses.",
      "expected": {
        "peou1": "peou1",
        "peou2": "peou2",
        "peou3": "peou3",
        "peou4": "peou4",
        "pu1": "pu1",
        "pu2": "pu2",
        "pu3": "pu3",
        "pu4": "pu4",
        "bi1": "bi1",
        "bi2": "bi2",
        "bi3": "bi3"
      },
      "reverse": []
    },
    {
      "id": "behaviour",
      "dimension": "interpretation",
      "kind": "choice",
      "prompt": "What should an SEM program do when indicators are bound to columns that are missing from the data?",
      "multiple": false,
      "options": [
        {
          "id": "a",
          "text": "Refuse to estimate and name the missing columns.",
          "correct": true,
          "feedback": "Correct. That is what SEM Studio does; any estimate would be for a different model than the one specified."
        },
        {
          "id": "b",
          "text": "Drop the affected indicators silently and estimate the rest.",
          "correct": false,
          "feedback": "That changes the measurement model without telling you; results would not correspond to your specification."
        },
        {
          "id": "c",
          "text": "Fill the missing columns with zeros.",
          "correct": false,
          "feedback": "Invented values would produce meaningless estimates."
        }
      ]
    },
    {
      "id": "ave-bi",
      "dimension": "numeric",
      "kind": "number",
      "prompt": "Run PLS-SEM once the mapping is fixed and enter the AVE of BI.",
      "answer": 0.806,
      "tolerance": 0.004,
      "feedbackCorrect": "Correct. With all three items bound, BI's indicators share most of their variance with the construct.",
      "feedbackWrong": "Not the expected value. Check that bi3 is bound to column bi3 (not another column) and that you read the AVE of BI.",
      "derivation": {
        "source": {
          "fixture": "tam-mediation"
        },
        "analysis": {
          "method": "pls-sem",
          "engine": "browser",
          "estimator": "pls-pm",
          "missingData": "listwise",
          "pls": {
            "innerWeighting": "path",
            "maxIterations": 300,
            "tolerance": 1e-07
          }
        },
        "constructMetric": {
          "constructId": "c_bi",
