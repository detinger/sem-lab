  "tasks": [
    {
      "id": "model",
      "dimension": "structure",
      "kind": "model",
      "prompt": "Build the measurement and structural model described in the brief. Names may differ (e.g. \"Ease of use\" for PEOU); layout is not scored.",
      "check": {
        "constructs": [
          {
            "key": "peou",
            "aliases": [
              "PEOU",
              "Perceived ease of use",
              "Ease of use",
              "EOU"
            ],
            "measurement": "reflective",
            "indicators": [
              "peou1",
              "peou2",
              "peou3",
              "peou4"
            ]
          },
          {
            "key": "pu",
            "aliases": [
              "PU",
              "Perceived usefulness",
              "Usefulness"
            ],
            "measurement": "reflective",
            "indicators": [
              "pu1",
              "pu2",
              "pu3",
              "pu4"
            ]
          },
          {
            "key": "bi",
            "aliases": [
              "BI",
              "Behavioural intention",
              "Behavioral intention",
              "Intention",
              "Intention to use"
            ],
            "measurement": "reflective",
            "indicators": [
              "bi1",
              "bi2",
              "bi3"
            ]
          }
        ],
        "paths": [
          [
            "peou",
            "pu"
          ],
          [
            "pu",
            "bi"
          ],
          [
            "peou",
            "bi"
          ]
        ],
        "exactPaths": true,
        "allowExtraConstructs": false
      }
    },
    {
      "id": "role-pu",
      "dimension": "interpretation",
      "kind": "choice",
      "prompt": "Given H1–H3, what role does PU play in the model?",
      "multiple": false,
      "options": [
        {
          "id": "a",
          "text": "A mediator between PEOU and BI: PEOU can affect BI directly (H3) and through PU (H1 and H2).",
          "correct": true,
          "feedback": "Correct. H1 and H2 together form an indirect route; H3 is the direct route."
        },
        {
          "id": "b",
          "text": "A moderator of the PEOU → BI relationship.",
          "correct": false,
          "feedback": "A moderator changes the strength of an effect and would need an interaction term. Nothing in H1–H3 says that."
        },
        {
          "id": "c",
          "text": "An exogenous construct.",
          "correct": false,
          "feedback": "PU receives an arrow from PEOU (H1), so it is endogenous."
        }
      ]
    },
    {
      "id": "r2-bi",
      "dimension": "numeric",
      "kind": "number",
      "prompt": "Run PLS-SEM with the default settings (path weighting). Enter the R² of BI.",
      "answer": 0.331,
      "tolerance": 0.004,
      "feedbackCorrect": "Correct. PEOU and PU together explain about a third of the variance of BI in this sample.",
      "feedbackWrong": "Not the expected value. Check that BI has exactly the three bi items, that both PEOU and PU point at BI, and that you read R² of BI rather than of PU.",
      "derivation": {
        "source": {
          "fixture": "tam-mediation"
        },
        "analysis": {
          "method": "pls-sem",
          "engine": "browser",
          "estimator": "pls-pm",
          "missingData": "listwise",
          "pls": {
            "innerWeighting": "path",
            "maxIterations": 300,
            "tolerance": 1e-07
          }
        },
        "constructMetric": {
          "constructId": "c_bi",
          "metric": "r2"
        }
      }
    }
  ],
  "hints": [
    "Start with the three constructs; each hypothesis names its two constructs and its direction.",
    "Every item belongs to exactly one construct; the item prefix tells you which.",
    "\"X influences Y\" means an arrow from X to Y. Count your structural arrows: there is one per hypothesis.",
    "R² is reported for endogenous constructs only. Which constructs receive arrows?"
  ],
  "solution": [
    {
      "kind": "p",
      "text": "Three reflective constructs: PEOU (peou1–peou4), PU (pu1–pu4), BI (bi1–bi3). Structural paths PEOU → PU (H1), PU → BI (H2) and PEOU → BI (H3)."
    },
    {
      "kind": "p",
      "text": "With classic PLS-SEM and path weighting R²(BI) ≈ .331 and R²(PU) ≈ .248. PU lies on the indirect route PEOU → PU → BI, so it is a mediator; whether mediation is supported is tested in Level 4."
    }
  ],
  "nextLesson": "pls-algorithm"
}
