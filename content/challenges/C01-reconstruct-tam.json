{
  "id": "reconstruct-tam",
  "number": 1,
  "title": "Reconstruct TAM from written hypotheses",
  "category": "model",
  "method": "pls",
  "difficulty": 1,
  "prerequisiteLessons": [
    "from-theory-to-model",
    "measurement-and-structural-model"
  ],
  "skills": [
    "Translating hypotheses into a path diagram",
    "Assigning indicators to constructs",
    "Reading R²"
  ],
  "brief": [
    {
      "kind": "p",
      "text": "A study of a new learning platform states its measures and hypotheses in words. Build the model that the text describes; the dataset (SYNTHETIC) is already loaded and every item is bound to its column."
    },
    {
      "kind": "list",
      "ordered": false,
      "items": [
        "**Perceived ease of use (PEOU):** items peou1–peou4, e.g. \"Learning to use the platform is easy for me.\"",
        "**Perceived usefulness (PU):** items pu1–pu4, e.g. \"Using the platform improves my learning.\"",
        "**Behavioural intention (BI):** items bi1–bi3, e.g. \"I intend to keep using the platform.\"",
        "All three are measured reflectively on 7-point agreement scales."
      ]
    },
    {
      "kind": "list",
      "ordered": false,
      "items": [
        "**H1:** Perceived ease of use positively influences perceived usefulness.",
        "**H2:** Perceived usefulness positively influences behavioural intention.",
        "**H3:** Perceived ease of use positively influences behavioural intention."
      ]
    }
  ],
  "starter": {
    "title": "Learning platform study (items only)",
    "model": {
      "constructs": [],
      "indicators": [
        {
          "column": "peou1",
          "id": "i_peou1",
