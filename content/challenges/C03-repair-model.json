  "tasks": [
    {
      "id": "model",
      "dimension": "structure",
      "kind": "model",
      "prompt": "Repair the model so that it matches H1–H3 with every collected item in its construct.",
      "check": {
        "constructs": [
          {
            "key": "peou",
            "aliases": [
              "PEOU",
              "Perceived ease of use",
              "Ease of use",
              "EOU"
            ],
            "measurement": "reflective",
            "indicators": [
              "peou1",
              "peou2",
              "peou3",
              "peou4"
            ]
          },
          {
            "key": "pu",
            "aliases": [
              "PU",
              "Perceived usefulness",
              "Usefulness"
            ],
            "measurement": "reflective",
            "indicators": [
              "pu1",
              "pu2",
              "pu3",
              "pu4"
            ]
          },
          {
            "key": "bi",
            "aliases": [
              "BI",
              "Behavioural intention",
              "Behavioral intention",
              "Intention",
              "Intention to use"
            ],
            "measurement": "reflective",
            "indicators": [
              "bi1",
              "bi2",
              "bi3"
            ]
          }
        ],
        "paths": [
          [
            "peou",
            "pu"
          ],
          [
            "pu",
            "bi"
          ],
          [
            "peou",
            "bi"
          ]
        ],
        "exactPaths": true,
        "allowExtraConstructs": false
      }
    },
    {
      "id": "cycle",
      "dimension": "interpretation",
      "kind": "choice",
      "prompt": "Why can the arrow BI → PEOU not stay in a PLS-SEM model that already has PEOU → PU → BI?",
      "multiple": false,
      "options": [
        {
          "id": "a",
          "text": "It closes a feedback loop; PLS path estimation by OLS requires a recursive (acyclic) structural model, and the loop also contradicts H3's direction.",
          "correct": true,
          "feedback": "Correct. SEM Studio flags structural cycles before estimation."
        },
        {
          "id": "b",
          "text": "Because BI has only three indicators.",
          "correct": false,
          "feedback": "The number of indicators has nothing to do with the direction of structural arrows."
        },
        {
          "id": "c",
          "text": "It is allowed; PLS simply ignores the arrow.",
          "correct": false,
          "feedback": "The cycle is a validation error; nothing is estimated until it is removed."
        }
      ]
    },
    {
      "id": "att",
      "dimension": "structure",
      "kind": "choice",
      "prompt": "What should happen to the construct ATT?",
      "multiple": false,
      "options": [
        {
          "id": "a",
          "text": "Delete it: it has no indicators and no hypothesis involves it.",
          "correct": true,
          "feedback": "Correct. A construct without indicators cannot be estimated, and the study has no attitude data."
        },
        {
          "id": "b",
          "text": "Give it the bi items so it can be estimated.",
          "correct": false,
          "feedback": "Items measure the construct they were written for; borrowing BI's items would create two copies of the same construct."
        },
        {
          "id": "c",
          "text": "Connect it to BI to remove the warning.",
          "correct": false,
          "feedback": "An arrow does not give a construct data; it would still have no indicators."
        }
      ]
    },
    {
      "id": "path-peou-bi",
      "dimension": "numeric",
      "kind": "number",
      "prompt": "Run PLS-SEM on the repaired model and enter the direct path PEOU → BI.",
      "answer": 0.128,
      "tolerance": 0.004,
      "feedbackCorrect": "Correct. The direct effect of ease of use on intention is small once usefulness is in the model.",
      "feedbackWrong": "Not the expected value. Check that pu4 is back in PU, that the arrow runs from PEOU to BI, and that you read the direct path, not the total effect.",
      "derivation": {
        "source": {
          "fixture": "tam-mediation"
        },
        "analysis": {
          "method": "pls-sem",
          "engine": "browser",
          "estimator": "pls-pm",
          "missingData": "listwise",
          "pls": {
            "innerWeighting": "path",
            "maxIterations": 300,
            "tolerance": 1e-07
          }
        },
        "parameterKey": "path:c_peou->c_bi"
      }
    }
  ],
  "hints": [
    "Open the check panel in the modeler; it lists errors and warnings with the elements involved.",
    "Look for an item that belongs to no construct.",
    "Follow the arrows from PEOU: can you come back to PEOU? Compare each arrow with the direction stated in H3.",
    "A construct needs at least one indicator, and the study collected none for attitude."
  ],
  "solution": [
    {
      "kind": "p",
      "text": "Three problems: item pu4 was not assigned to PU (orphan indicator), H3 was drawn backwards (BI → PEOU), creating a cycle PEOU → PU → BI → PEOU, and ATT has no indicators and no role. Fix: add pu4 to PU, replace BI → PEOU by PEOU → BI, delete ATT."
    },
    {
      "kind": "p",
      "text": "The repaired model gives PEOU → BI ≈ .128, PEOU → PU ≈ .498 and PU → BI ≈ .501."
    }
  ],
  "nextLesson": "covariance-and-correlation"
}
