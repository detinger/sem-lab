{
  "$id": "https://sem-studio.local/schema/dataset-ref.json",
  "title": "dataset-ref",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "importedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "rowCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "type": {
            "type": "string",
            "enum": [
              "numeric",
              "text",
              "empty"
            ]
          },
          "nMissing": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "nUnique": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "observedMin": {
            "type": [
              "number",
              "null"
            ]
          },
          "observedMax": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "type",
          "nMissing",
          "nUnique",
          "observedMin",
          "observedMax"
        ],
        "additionalProperties": false
      }
    },
    "source": {
      "type": "string",
      "maxLength": 500
    },
    "provenance": {
      "type": "object",
      "properties": {
        "synthetic": {
          "type": "boolean"
        },
        "licence": {
          "type": "string",
          "maxLength": 200
        },
        "attribution": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "synthetic"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "fingerprint",
    "importedAt",
    "rowCount",
    "columns"
  ],
  "additionalProperties": false
}
